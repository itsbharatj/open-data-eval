{
  "$defs": {
    "action": {
      "enum": [
        "STOP",
        "MOVE_FORWARD",
        "TURN_LEFT",
        "TURN_RIGHT",
        "LOOK_UP",
        "LOOK_DOWN"
      ]
    },
    "episode_id": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "eval_set": {
      "description": "names = keys of data/val_unseen_splits.json (smoke 60, quick 306, dev 1,413, lockbox 426) + C10 fixtures (g60, ha-mini)",
      "pattern": "^(smoke|quick|dev|lockbox|val_unseen|val_seen|trainho|g60|ha-mini|test|syn-[a-z0-9-]+)(@v[0-9]+)?$",
      "type": "string"
    },
    "input_kind": {
      "enum": [
        "rgb",
        "depth",
        "pose",
        "instruction",
        "episode_id",
        "start_pose",
        "siblings",
        "navmesh",
        "humans_gt",
        "goal_gt",
        "scene_mesh",
        "test_scan_assets",
        "collision_flag"
      ]
    },
    "mode": {
      "enum": [
        "compliant",
        "privileged"
      ]
    },
    "prob": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "quat_xyzw": {
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "regime": {
      "description": "C1 R0 wall=official wall-clock; R1 wallx:<s/step> throttled; R2 frz:<k> frozen at frame k; R3 sps:<S> deterministic schedule at S steps/s (C6 virtual clock dhat=5 ms == sps:200); R4 allf = all-frames kinematic certificate; C6 extras: lock (step-locked), stall:<k>, rand:<seed> (random monotone schedule); static = no humans",
      "pattern": "^(wall|wallx:[0-9.]+|frz:([0-9]|[1-9][0-9]|1[01][0-9])|sps:[0-9]+|allf|lock|stall:([0-9]|[1-9][0-9]|1[01][0-9])|rand:[0-9]+|static)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "val_seen",
        "val_unseen",
        "test",
        "synthetic"
      ]
    },
    "task_id": {
      "pattern": "^(W[0-8]|INT|REV|OPS)-T[0-9]{2,3}$",
      "type": "string"
    },
    "utc": {
      "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?Z$",
      "type": "string"
    },
    "vec3": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "$id": "havln-team/contracts/SubmissionRecord/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "uploaded_utc": {
            "type": "string"
          }
        },
        "required": [
          "uploaded_utc"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "G1_contract": {
                "const": true
              },
              "G2_compliance": {
                "const": true
              },
              "G3_timing": {
                "const": true
              },
              "G4_ledger": {
                "const": true
              },
              "G5_new_sha": {
                "const": true
              },
              "G6_human": {
                "const": true
              },
              "G7_regenerated": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "agent_fp": {
      "$ref": "#/$defs/sha256"
    },
    "approved_by": {
      "type": "string"
    },
    "codabench_submission_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract": {
      "const": "SubmissionRecord/1"
    },
    "delta_vs_predicted": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "flags": {
      "properties": {
        "cross_episode_memory": {
          "type": "boolean"
        },
        "multi_rollout": {
          "type": "boolean"
        },
        "siblings": {
          "type": "boolean"
        }
      },
      "required": [
        "multi_rollout",
        "siblings",
        "cross_episode_memory"
      ],
      "type": "object"
    },
    "gates": {
      "properties": {
        "G1_contract": {
          "type": "boolean"
        },
        "G2_compliance": {
          "type": "boolean"
        },
        "G3_timing": {
          "type": "boolean"
        },
        "G4_ledger": {
          "type": "boolean"
        },
        "G5_new_sha": {
          "type": "boolean"
        },
        "G6_human": {
          "type": "boolean"
        },
        "G7_regenerated": {
          "type": "boolean"
        }
      },
      "required": [
        "G1_contract",
        "G2_compliance",
        "G3_timing",
        "G4_ledger",
        "G5_new_sha",
        "G6_human",
        "G7_regenerated"
      ],
      "type": "object"
    },
    "inputs_used": {
      "items": {
        "$ref": "#/$defs/input_kind"
      },
      "type": "array"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "$ref": "#/$defs/mode"
    },
    "official": {
      "anyOf": [
        {
          "properties": {
            "CR": {
              "type": "number"
            },
            "NE": {
              "type": "number"
            },
            "SR": {
              "type": "number"
            },
            "Score": {
              "type": "number"
            },
            "TCR": {
              "type": "number"
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "enum": [
        "phase1",
        "phase2"
      ]
    },
    "predicted_envelope": {
      "description": "min/max per metric over the release-gate regimes, from dev/lockbox calibration",
      "type": "object"
    },
    "rationale": {
      "maxLength": 1000,
      "type": "string"
    },
    "release_tag": {
      "pattern": "^rc-20[0-9]{6}-[0-9]+$",
      "type": "string"
    },
    "run_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "uploaded_utc": {
      "anyOf": [
        {
          "$ref": "#/$defs/utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "zip_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "contract",
    "phase",
    "zip_sha256",
    "release_tag",
    "run_ids",
    "agent_fp",
    "mode",
    "inputs_used",
    "flags",
    "gates",
    "predicted_envelope",
    "approved_by"
  ],
  "title": "SubmissionRecord/1: one per upload (ledger/submissions/<zip_sha256>.json) = C10 ledger_submission + compliance manifest, with C10 gates G1-G6 plus C5's G7 (bit-reproducible regeneration from the RC tag). Owner W6; G6 = human sign-off.",
  "type": "object"
}