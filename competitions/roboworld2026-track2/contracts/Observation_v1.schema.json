{
  "$defs": {
    "action": {
      "enum": [
        "STOP",
        "MOVE_FORWARD",
        "TURN_LEFT",
        "TURN_RIGHT",
        "LOOK_UP",
        "LOOK_DOWN"
      ]
    },
    "episode_id": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "eval_set": {
      "description": "names = keys of data/val_unseen_splits.json (smoke 60, quick 306, dev 1,413, lockbox 426) + C10 fixtures (g60, ha-mini)",
      "pattern": "^(smoke|quick|dev|lockbox|val_unseen|val_seen|trainho|g60|ha-mini|test|syn-[a-z0-9-]+)(@v[0-9]+)?$",
      "type": "string"
    },
    "input_kind": {
      "enum": [
        "rgb",
        "depth",
        "pose",
        "instruction",
        "episode_id",
        "start_pose",
        "siblings",
        "navmesh",
        "humans_gt",
        "goal_gt",
        "scene_mesh",
        "test_scan_assets",
        "collision_flag"
      ]
    },
    "mode": {
      "enum": [
        "compliant",
        "privileged"
      ]
    },
    "prob": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "quat_xyzw": {
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "regime": {
      "description": "C1 R0 wall=official wall-clock; R1 wallx:<s/step> throttled; R2 frz:<k> frozen at frame k; R3 sps:<S> deterministic schedule at S steps/s (C6 virtual clock dhat=5 ms == sps:200); R4 allf = all-frames kinematic certificate; C6 extras: lock (step-locked), stall:<k>, rand:<seed> (random monotone schedule); static = no humans",
      "pattern": "^(wall|wallx:[0-9.]+|frz:([0-9]|[1-9][0-9]|1[01][0-9])|sps:[0-9]+|allf|lock|stall:([0-9]|[1-9][0-9]|1[01][0-9])|rand:[0-9]+|static)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "val_seen",
        "val_unseen",
        "test",
        "synthetic"
      ]
    },
    "task_id": {
      "pattern": "^(W[0-8]|INT|REV|OPS)-T[0-9]{2,3}$",
      "type": "string"
    },
    "utc": {
      "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?Z$",
      "type": "string"
    },
    "vec3": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "$id": "havln-team/contracts/Observation/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions_used": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "camera": {
      "properties": {
        "height_m": {
          "type": "number"
        },
        "hfov_deg": {
          "type": "number"
        },
        "pitch_deg": {
          "type": "number"
        },
        "tilt_step_deg": {
          "type": "number"
        }
      },
      "required": [
        "height_m",
        "hfov_deg",
        "pitch_deg"
      ],
      "type": "object"
    },
    "contract": {
      "const": "Observation/1"
    },
    "depth": {
      "properties": {
        "max_range_m": {
          "type": "number"
        },
        "min_range_m": {
          "type": "number"
        },
        "ref": {
          "type": "string"
        },
        "shape": {
          "const": [
            256,
            256,
            1
          ]
        },
        "units": {
          "const": "m"
        }
      },
      "required": [
        "ref",
        "shape",
        "units"
      ],
      "type": "object"
    },
    "episode_id": {
      "$ref": "#/$defs/episode_id"
    },
    "last_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "type": "null"
        }
      ]
    },
    "pose": {
      "additionalProperties": false,
      "properties": {
        "position_ep": {
          "$ref": "#/$defs/vec3"
        },
        "position_world": {
          "$ref": "#/$defs/vec3"
        },
        "source": {
          "const": "gps_compass"
        },
        "yaw_ep": {
          "type": "number"
        }
      },
      "required": [
        "source",
        "position_ep",
        "yaw_ep"
      ],
      "type": "object"
    },
    "pose_delta_m": {
      "anyOf": [
        {
          "description": "planar displacement caused by last_action; < 0.249 after MOVE_FORWARD => contact suspected",
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "rgb": {
      "properties": {
        "ref": {
          "type": "string"
        },
        "shape": {
          "const": [
            224,
            224,
            3
          ]
        }
      },
      "required": [
        "ref",
        "shape"
      ],
      "type": "object"
    },
    "t": {
      "description": "0 = observation after reset",
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "contract",
    "episode_id",
    "t",
    "rgb",
    "depth",
    "pose",
    "camera",
    "actions_used",
    "last_action"
  ],
  "title": "Observation/1: per-step compliant observation (logged form; in-process the refs are numpy arrays). Owner W1. Episode frame: origin = start position, +x = start heading, +y = left, +z = up; yaw_ep = yaw - yaw_start, CCW+, TURN_LEFT = +15 deg. Sensor constants (camera height, HFOV, depth range/normalisation, tilt) MUST be copied from the image's /app/config/challenge_submission.yaml by W1 (habitat defaults: camera 1.25 m, HFOV 90, depth 0-10 m normalised).",
  "type": "object"
}