{
  "$defs": {
    "action": {
      "enum": [
        "STOP",
        "MOVE_FORWARD",
        "TURN_LEFT",
        "TURN_RIGHT",
        "LOOK_UP",
        "LOOK_DOWN"
      ]
    },
    "episode_id": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "eval_set": {
      "description": "names = keys of data/val_unseen_splits.json (smoke 60, quick 306, dev 1,413, lockbox 426) + C10 fixtures (g60, ha-mini)",
      "pattern": "^(smoke|quick|dev|lockbox|val_unseen|val_seen|trainho|g60|ha-mini|test|syn-[a-z0-9-]+)(@v[0-9]+)?$",
      "type": "string"
    },
    "input_kind": {
      "enum": [
        "rgb",
        "depth",
        "pose",
        "instruction",
        "episode_id",
        "start_pose",
        "siblings",
        "navmesh",
        "humans_gt",
        "goal_gt",
        "scene_mesh",
        "test_scan_assets",
        "collision_flag"
      ]
    },
    "mode": {
      "enum": [
        "compliant",
        "privileged"
      ]
    },
    "prob": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "quat_xyzw": {
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "regime": {
      "description": "C1 R0 wall=official wall-clock; R1 wallx:<s/step> throttled; R2 frz:<k> frozen at frame k; R3 sps:<S> deterministic schedule at S steps/s (C6 virtual clock dhat=5 ms == sps:200); R4 allf = all-frames kinematic certificate; C6 extras: lock (step-locked), stall:<k>, rand:<seed> (random monotone schedule); static = no humans",
      "pattern": "^(wall|wallx:[0-9.]+|frz:([0-9]|[1-9][0-9]|1[01][0-9])|sps:[0-9]+|allf|lock|stall:([0-9]|[1-9][0-9]|1[01][0-9])|rand:[0-9]+|static)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "val_seen",
        "val_unseen",
        "test",
        "synthetic"
      ]
    },
    "task_id": {
      "pattern": "^(W[0-8]|INT|REV|OPS)-T[0-9]{2,3}$",
      "type": "string"
    },
    "utc": {
      "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?Z$",
      "type": "string"
    },
    "vec3": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "$id": "havln-team/contracts/InstructionProgram/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "$ref": "#/$defs/prob"
    },
    "contract": {
      "const": "InstructionProgram/1"
    },
    "episode_id": {
      "$ref": "#/$defs/episode_id"
    },
    "humans": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "activity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "mention_id": {
            "type": "string"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "enum": [
              "start",
              "during",
              "end",
              "unknown"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "mention_id",
          "text",
          "role"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "instruction_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parser": {
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "prompt_sha256",
        "version"
      ],
      "type": "object"
    },
    "route_only_paraphrase": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "start_context": {
      "properties": {
        "facing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "distance_hint_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "human_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "idx": {
            "minimum": 0,
            "type": "integer"
          },
          "landmark": {
            "anyOf": [
              {
                "properties": {
                  "category": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "relation": {
            "anyOf": [
              {
                "enum": [
                  "past",
                  "through",
                  "into",
                  "until",
                  "toward",
                  "around",
                  "at",
                  "between",
                  "along",
                  "out_of"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "verb": {
            "enum": [
              "go",
              "turn_left",
              "turn_right",
              "turn_around",
              "go_up",
              "go_down",
              "enter",
              "exit",
              "pass",
              "follow",
              "wait",
              "stop"
            ]
          }
        },
        "required": [
          "idx",
          "verb"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "stop": {
      "properties": {
        "human_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  "required": [
    "contract",
    "episode_id",
    "instruction_sha256",
    "parser",
    "steps",
    "humans",
    "stop",
    "confidence"
  ],
  "title": "InstructionProgram/1: parse(instruction) output. Owner W3. Consumers: W4 policies, W5 selector, W7 analysis.",
  "type": "object"
}