{
  "$defs": {
    "action": {
      "enum": [
        "STOP",
        "MOVE_FORWARD",
        "TURN_LEFT",
        "TURN_RIGHT",
        "LOOK_UP",
        "LOOK_DOWN"
      ]
    },
    "episode_id": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "eval_set": {
      "description": "names = keys of data/val_unseen_splits.json (smoke 60, quick 306, dev 1,413, lockbox 426) + C10 fixtures (g60, ha-mini)",
      "pattern": "^(smoke|quick|dev|lockbox|val_unseen|val_seen|trainho|g60|ha-mini|test|syn-[a-z0-9-]+)(@v[0-9]+)?$",
      "type": "string"
    },
    "input_kind": {
      "enum": [
        "rgb",
        "depth",
        "pose",
        "instruction",
        "episode_id",
        "start_pose",
        "siblings",
        "navmesh",
        "humans_gt",
        "goal_gt",
        "scene_mesh",
        "test_scan_assets",
        "collision_flag"
      ]
    },
    "mode": {
      "enum": [
        "compliant",
        "privileged"
      ]
    },
    "prob": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "quat_xyzw": {
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "regime": {
      "description": "C1 R0 wall=official wall-clock; R1 wallx:<s/step> throttled; R2 frz:<k> frozen at frame k; R3 sps:<S> deterministic schedule at S steps/s (C6 virtual clock dhat=5 ms == sps:200); R4 allf = all-frames kinematic certificate; C6 extras: lock (step-locked), stall:<k>, rand:<seed> (random monotone schedule); static = no humans",
      "pattern": "^(wall|wallx:[0-9.]+|frz:([0-9]|[1-9][0-9]|1[01][0-9])|sps:[0-9]+|allf|lock|stall:([0-9]|[1-9][0-9]|1[01][0-9])|rand:[0-9]+|static)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "val_seen",
        "val_unseen",
        "test",
        "synthetic"
      ]
    },
    "task_id": {
      "pattern": "^(W[0-8]|INT|REV|OPS)-T[0-9]{2,3}$",
      "type": "string"
    },
    "utc": {
      "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?Z$",
      "type": "string"
    },
    "vec3": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "$id": "havln-team/contracts/TaskBrief/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/task_id"
      },
      "type": "array"
    },
    "compute_quota": {
      "properties": {
        "gpu_h": {
          "type": "number"
        },
        "llm_usd": {
          "type": "number"
        },
        "replay_shards_in_flight": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "gpu_h",
        "llm_usd"
      ],
      "type": "object"
    },
    "contract": {
      "const": "TaskBrief/1"
    },
    "contracts_in": {
      "items": {
        "pattern": "^[A-Za-z]+/[0-9]+$",
        "type": "string"
      },
      "type": "array"
    },
    "contracts_out": {
      "items": {
        "pattern": "^[A-Za-z]+/[0-9]+$",
        "type": "string"
      },
      "type": "array"
    },
    "created": {
      "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$",
      "type": "string"
    },
    "depends_on": {
      "items": {
        "$ref": "#/$defs/task_id"
      },
      "type": "array"
    },
    "due": {
      "anyOf": [
        {
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "eval_sets": {
      "items": {
        "$ref": "#/$defs/eval_set"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/task_id"
    },
    "kill_criterion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_session": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "regime": {
      "description": "A = code runs in the compliant inference path; B = oracle/ only",
      "enum": [
        "A",
        "B",
        "A+B"
      ]
    },
    "role": {
      "enum": [
        "lead",
        "implementer",
        "reviewer",
        "redteam",
        "scribe"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "blocked",
        "review",
        "done",
        "killed"
      ]
    },
    "timebox_agent_days": {
      "exclusiveMinimum": 0,
      "maximum": 3,
      "type": "number"
    },
    "title": {
      "maxLength": 80,
      "type": "string"
    },
    "workstream": {
      "enum": [
        "W0",
        "W1",
        "W2",
        "W3",
        "W4",
        "W5",
        "W6",
        "W7",
        "INT",
        "REV",
        "OPS"
      ]
    }
  },
  "required": [
    "contract",
    "id",
    "title",
    "workstream",
    "role",
    "regime",
    "status",
    "created",
    "timebox_agent_days",
    "depends_on",
    "contracts_in",
    "contracts_out",
    "eval_sets",
    "compute_quota"
  ],
  "title": "TaskBrief/1: YAML front matter of briefs/<WS>/<task-id>.md (validated in CI). Status is the single source for STATUS.md.",
  "type": "object"
}