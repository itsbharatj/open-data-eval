{
  "$defs": {
    "action": {
      "enum": [
        "STOP",
        "MOVE_FORWARD",
        "TURN_LEFT",
        "TURN_RIGHT",
        "LOOK_UP",
        "LOOK_DOWN"
      ]
    },
    "episode_id": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "eval_set": {
      "description": "names = keys of data/val_unseen_splits.json (smoke 60, quick 306, dev 1,413, lockbox 426) + C10 fixtures (g60, ha-mini)",
      "pattern": "^(smoke|quick|dev|lockbox|val_unseen|val_seen|trainho|g60|ha-mini|test|syn-[a-z0-9-]+)(@v[0-9]+)?$",
      "type": "string"
    },
    "input_kind": {
      "enum": [
        "rgb",
        "depth",
        "pose",
        "instruction",
        "episode_id",
        "start_pose",
        "siblings",
        "navmesh",
        "humans_gt",
        "goal_gt",
        "scene_mesh",
        "test_scan_assets",
        "collision_flag"
      ]
    },
    "mode": {
      "enum": [
        "compliant",
        "privileged"
      ]
    },
    "prob": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "quat_xyzw": {
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "regime": {
      "description": "C1 R0 wall=official wall-clock; R1 wallx:<s/step> throttled; R2 frz:<k> frozen at frame k; R3 sps:<S> deterministic schedule at S steps/s (C6 virtual clock dhat=5 ms == sps:200); R4 allf = all-frames kinematic certificate; C6 extras: lock (step-locked), stall:<k>, rand:<seed> (random monotone schedule); static = no humans",
      "pattern": "^(wall|wallx:[0-9.]+|frz:([0-9]|[1-9][0-9]|1[01][0-9])|sps:[0-9]+|allf|lock|stall:([0-9]|[1-9][0-9]|1[01][0-9])|rand:[0-9]+|static)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "val_seen",
        "val_unseen",
        "test",
        "synthetic"
      ]
    },
    "task_id": {
      "pattern": "^(W[0-8]|INT|REV|OPS)-T[0-9]{2,3}$",
      "type": "string"
    },
    "utc": {
      "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?Z$",
      "type": "string"
    },
    "vec3": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "$id": "havln-team/contracts/ScoreResult/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate": {
      "anyOf": [
        {
          "properties": {
            "CR": {
              "type": "number"
            },
            "NE": {
              "type": "number"
            },
            "SR": {
              "type": "number"
            },
            "Score": {
              "type": "number"
            },
            "TCR": {
              "type": "number"
            },
            "cr_mode": {
              "const": "human_influenced"
            },
            "n": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "n",
            "SR",
            "NE",
            "CR",
            "TCR",
            "Score",
            "cr_mode"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract": {
      "const": "ScoreResult/1"
    },
    "eval_set": {
      "$ref": "#/$defs/eval_set"
    },
    "fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "regime": {
      "$ref": "#/$defs/regime"
    },
    "rows": {
      "items": {
        "properties": {
          "CR": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "SR": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "TCR": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "collision_steps": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "collisions": {
            "minimum": 0,
            "type": "integer"
          },
          "distance_to_goal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "episode_id": {
            "$ref": "#/$defs/episode_id"
          },
          "final_position": {
            "$ref": "#/$defs/vec3"
          },
          "frames_seen": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "steps_executed": {
            "minimum": 0,
            "type": "integer"
          },
          "stopped": {
            "type": "boolean"
          },
          "success": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "episode_id",
          "steps_executed",
          "stopped",
          "collisions",
          "collision_steps"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "scan": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "split": {
      "$ref": "#/$defs/split"
    },
    "task_id": {
      "$ref": "#/$defs/sha256"
    },
    "timing": {
      "properties": {
        "steps_per_s": {
          "type": "number"
        },
        "wall_s": {
          "type": "number"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "contract",
    "task_id",
    "fingerprint",
    "regime",
    "split",
    "eval_set",
    "rows"
  ],
  "title": "ScoreResult/1: per-regime, per-shard result. Owner W1. aggregate uses havln_tools.aggregate(cr_mode='human_influenced').",
  "type": "object"
}